---
import { business } from '../data/site';
---

<section class="booking-composer" id="booking" aria-labelledby="booking-title">
	<div class="booking-composer__intro">
		<p class="eyebrow">Запись в студию</p>
		<h2 id="booking-title">Соберите сообщение для студии</h2>
		<p>
			На основном сайте заявка отправляется администратору. Если сервер недоступен,
			сайт честно предложит скопировать сообщение и открыть диалог в VK.
		</p>
	</div>

	<form class="booking-form" data-booking-form data-vk-url={business.vk}>
		<div class="honeypot-field" aria-hidden="true">
			<label>
				<span>Не заполняйте это поле</span>
				<input name="website" tabindex="-1" autocomplete="off" />
			</label>
		</div>
		<label>
			<span>Как вас зовут</span>
			<input name="name" autocomplete="name" required placeholder="Например, Анна" />
		</label>
		<label>
			<span>Телефон для связи</span>
			<input
				name="phone"
				type="tel"
				autocomplete="tel"
				inputmode="tel"
				required
				placeholder="+7 999 000-00-00"
			/>
		</label>
		<label>
			<span>Какой формат интересует</span>
			<select name="format" required>
				<option value="">Выберите формат</option>
				<option>Групповой мастер-класс</option>
				<option>Индивидуальный мастер-класс</option>
				<option>Гончарный круг</option>
				<option>Свидание</option>
				<option>День рождения</option>
				<option>Корпоратив</option>
				<option>Школьная группа</option>
				<option>Базовый курс</option>
				<option>Подарочный сертификат</option>
			</select>
		</label>
		<div class="booking-form__row">
			<label>
				<span>Желаемая дата</span>
				<input name="date" type="date" />
			</label>
			<label>
				<span>Количество гостей</span>
				<input name="guests" type="number" min="1" max="32" inputmode="numeric" placeholder="2" />
			</label>
		</div>
		<label>
			<span>Комментарий</span>
			<textarea name="comment" rows="3" placeholder="Например, хотим попробовать гончарный круг"></textarea>
		</label>
		<label class="message-preview-label">
			<span>Готовое сообщение</span>
			<textarea class="message-preview" data-message-preview rows="6" readonly></textarea>
		</label>
		<label class="consent-field">
			<input name="consent" type="checkbox" value="yes" required />
			<span>
				Согласен на обработку данных для ответа на заявку согласно
				<a href={`${import.meta.env.BASE_URL}privacy/`} target="_blank">политике конфиденциальности</a>.
			</span>
		</label>
		<button class="button" type="submit" data-submit-button>Проверяем возможность отправки…</button>
		<div class="booking-fallback" data-booking-fallback>
			<a class="text-link" href={business.vk} target="_blank" rel="noreferrer">Написать в VK</a>
			<a class="text-link" href={`tel:${business.phone}`}>Позвонить {business.phoneDisplay}</a>
		</div>
		<p class="form-status" data-form-status role="status"></p>
	</form>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
	const preview = form?.querySelector<HTMLTextAreaElement>('[data-message-preview]');
	const status = form?.querySelector<HTMLElement>('[data-form-status]');
	const submitButton = form?.querySelector<HTMLButtonElement>('[data-submit-button]');
	const fallback = form?.querySelector<HTMLElement>('[data-booking-fallback]');
	const base = import.meta.env.BASE_URL;
	const endpoint = `${base}api/contact.php`;
	let backendAvailable = false;

	const buildMessage = () => {
		if (!form) return '';
		const data = new FormData(form);
		const name = String(data.get('name') || '').trim();
		const phone = String(data.get('phone') || '').trim();
		const format = String(data.get('format') || '').trim();
		const dateValue = String(data.get('date') || '').trim();
		const guests = String(data.get('guests') || '').trim();
		const comment = String(data.get('comment') || '').trim();
		const date = dateValue
			? new Intl.DateTimeFormat('ru-RU').format(new Date(`${dateValue}T12:00:00`))
			: 'хочу уточнить свободные даты';

		return [
			'Здравствуйте! Хочу записаться в студию «Глина и Тепло».',
			`Имя: ${name || 'не указано'}.`,
			`Телефон: ${phone || 'не указан'}.`,
			`Формат: ${format || 'хочу подобрать вместе с вами'}.`,
			`Дата: ${date}.`,
			guests ? `Количество гостей: ${guests}.` : '',
			comment ? `Комментарий: ${comment}` : '',
		]
			.filter(Boolean)
			.join('\n');
	};

	const refreshPreview = () => {
		if (preview) preview.value = buildMessage();
	};

	form?.addEventListener('input', refreshPreview);
	refreshPreview();

	const setBackendState = (available: boolean) => {
		backendAvailable = available;
		if (!submitButton || !fallback || !status) return;
		submitButton.textContent = available ? 'Отправить заявку' : 'Скопировать и открыть VK';
		fallback.hidden = available;
		status.textContent = available
			? 'Заявка будет отправлена администратору студии.'
			: 'На этой версии сайта серверная отправка недоступна. Используйте VK или звонок.';
	};

	const checkBackend = async () => {
		try {
			const response = await fetch(`${endpoint}?health=1`, {
				headers: { Accept: 'application/json' },
				cache: 'no-store',
			});
			const data = await response.json();
			setBackendState(response.ok && data?.ok === true && data?.backend === 'php-mail');
		} catch (error) {
			console.info('PHP form backend is unavailable; VK fallback enabled.', error);
			setBackendState(false);
		}
	};

	void checkBackend();

	const copyAndOpenVk = async (message: string) => {
		const vkUrl = form?.dataset.vkUrl;
		if (vkUrl) window.open(vkUrl, '_blank', 'noopener,noreferrer');

		try {
			await navigator.clipboard.writeText(message);
			if (status) status.textContent = 'Сообщение скопировано. Вставьте его в открывшийся диалог VK.';
		} catch (error) {
			preview?.focus();
			preview?.select();
			if (status) {
				status.textContent =
					'Браузер не разрешил копирование. Текст выделен — скопируйте его вручную и вставьте в VK.';
			}
			console.warn('Clipboard access was denied:', error);
		}
	};

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!form.reportValidity() || !preview || !status) return;

		const message = buildMessage();
		preview.value = message;
		if (!backendAvailable) {
			await copyAndOpenVk(message);
			return;
		}

		if (submitButton) {
			submitButton.disabled = true;
			submitButton.textContent = 'Отправляем…';
		}
		status.textContent = '';

		try {
			const response = await fetch(endpoint, {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: new FormData(form),
			});
			const data = await response.json();
			if (!response.ok || data?.ok !== true) {
				throw new Error(data?.message || 'Сервер не подтвердил отправку заявки.');
			}

			status.textContent = data.message || 'Заявка отправлена. Администратор свяжется с вами.';
			form.reset();
			refreshPreview();
		} catch (error) {
			const message = error instanceof Error ? error.message : 'Не удалось отправить заявку.';
			status.textContent = `${message} Можно написать в VK или позвонить.`;
			fallback?.removeAttribute('hidden');
			console.error('Booking form submission failed:', error);
		} finally {
			if (submitButton) {
				submitButton.disabled = false;
				submitButton.textContent = 'Отправить заявку';
			}
		}
	});
</script>
