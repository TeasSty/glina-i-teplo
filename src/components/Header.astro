---
import { business, navigation } from '../data/site';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---

<header class="site-header" data-header>
	<a class="brand" href={base} aria-label={`${business.name}, на главную`}>
		<img
			class="brand__mark"
			src={`${base}logo-mark.png`}
			width="420"
			height="100"
			alt=""
			aria-hidden="true"
		/>
		<span>
			<strong>Глина и Тепло</strong>
			<small>гончарная студия · Пенза</small>
		</span>
	</a>

	<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
		<span></span><span></span>
		<span class="sr-only">Открыть меню</span>
	</button>

	<nav class="site-nav" id="site-nav" aria-label="Основная навигация">
		{
			navigation.map((item) => (
				<a href={`${base}${item.href}`} aria-current={currentPath.includes(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>

	<a class="button button--small header-cta" href={`${base}contacts/#booking`}>Записаться</a>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
	const nav = header?.querySelector<HTMLElement>('.site-nav');

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!isOpen));
		header?.classList.toggle('is-menu-open', !isOpen);
	});

	nav?.addEventListener('click', () => {
		toggle?.setAttribute('aria-expanded', 'false');
		header?.classList.remove('is-menu-open');
	});
</script>
